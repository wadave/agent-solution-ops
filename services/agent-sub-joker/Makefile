# Build Docker image.
.PHONY: image
image:
	@echo "🐳  Creating $(service_slug) docker image..."
	@bash -c "./scripts/dev/docker_staging_py.sh $(service_slug)"
	@pushd $(BUILD)/docker/$(service_slug) && \
	echo "CWD: $(CURDIR)" && \
	docker build -t $(docker_repo_host)/$(project)/$(docker_repo_name)/$(service_name):latest -f ./services/$(service_slug)/Dockerfile --build-arg=SVC_SLUG=$(service_slug) .


# Authenticate Google Docker Registry
.PHONY: auth
auth: image
	@echo "🐳  Authenticate with Google Docker Registry..."
	gcloud auth configure-docker $(docker_repo_host)


# Push Docker image to Google Docker Registry
.PHONY: push
push: auth
	@echo "🐳  Push Docker image $(service_slug) to Google Docker Registry..."
	docker push $(docker_repo_host)/$(project)/$(docker_repo_name)/$(service_name):latest


# Deploy Cloud Run service
.PHONY: deploy
deploy: push
	@echo "☁️  Deploying $(service_slug) docker image to Google Cloud Platform..."
	gcloud run deploy $(service_name) --image $(docker_repo_host)/$(project)/$(docker_repo_name)/$(service_name):latest --platform managed --region $(region) --service-account $(service_account_email) --port $(service_port)
	@echo "This file prevents Terraform from copying default new service files into this directory on inital resource creation." > .lockoverwrite


# Check the Active GCloud Login
.PHONY: gcloud-check
gcloud-check:
	@echo -n "☁️  Active GCP Login: "
	@gcloud config list account --format "value(core.account)"
	@echo -n "☁️  Active GCP Project: "
	@gcloud config get-value project 2>&1 | grep -v 'Your active configuration is: '
	@echo -n "☁️  Active Service Account: "
	@curl "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/email" -H "Metadata-Flavor: Google" && echo ""


# Login and Configure GCloud Project
.PHONY: login
login:
	@echo -n "☁️  Login to Google Cloud and update Application Default Credentials"
	gcloud auth login --update-adc


# Configure GCloud Project
.PHONY: set-project
set-project:
ifndef project
	$(error project is not set!)
endif
	@echo -n "☁️  Configuring default config and billing quota projects"
	gcloud config set project "$(project)"
	gcloud auth application-default set-quota-project "$(project)"


