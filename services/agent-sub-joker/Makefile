.PHONY: run-adk-background
run-background: install
	@echo "🚀 Starting $(service_slug) ADK Web in background..."
	@bash -c './scripts/dev/run_local.sh --background'
	@bash -c "sleep 15"


.PHONY: stop-adk-background
stop-background:
	@if [ -f "$(PID_FILE)" ]; then \
		PID=$$(cat "$(PID_FILE)" | tr -d '\n'); \
		echo "🛑 Stopping $(service_slug) ADK Web with PID $$PID..."; \
		kill $$PID; \
		rm "$(PID_FILE)"; \
		echo "$(service_slug) stopped."; \
	else \
		echo "🛑 $(service_slug) ADK Web is not running in the background."; \
	fi


