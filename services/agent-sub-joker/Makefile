	$(VENV)/bin/bandit -r . --exclude ./venv,./test
	@echo "🛡️  Checking dependencies with PIP-Audit"
	$(VENV)/bin/pip freeze | grep -v "git+ssh" | $(VENV)/bin/pip-audit -r /dev/stdin


