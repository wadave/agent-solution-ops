.PHONY: stop-background
stop-background:
	@if [ -f "$(PID_FILE)" ]; then \
		PID=$$(cat "$(PID_FILE)" | tr -d '\n'); \
		echo "🛑 Stopping $(service_slug) with PID $$PID..."; \
		kill $$PID; \
		rm "$(PID_FILE)"; \
		echo "$(service_slug) stopped."; \
	else \
		echo "🛑 $(service_slug) is not running in the background."; \
	fi


