# =============================================================================
# Local Development Configuration
# =============================================================================
# Copy this file to .env in the project root and fill in your values.
# This single file configures both the ADK agent and the MCP server for
# local development. In production, environment variables are injected by
# Cloud Run / Agent Engine — this file is not used.

# =============================================================================
# GCP Project
# =============================================================================
GOOGLE_CLOUD_PROJECT=your-staging-project-id
GOOGLE_CLOUD_LOCATION=us-central1
PROJECT_ID=your-staging-project-id
PROJECT_NUMBER=your-project-number

# =============================================================================
# OAuth Credentials
# (Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs)
# Add both redirect URIs below to the allowed list on your OAuth client.
# =============================================================================
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Redirect URI for local ADK web UI
OAUTH_REDIRECT_URI_DEV=http://127.0.0.1:8000/dev-ui/
# Redirect URI for Gemini Enterprise (production)
OAUTH_REDIRECT_URI_PROD=https://vertexaisearch.cloud.google.com/oauth-redirect

# =============================================================================
# ADK Agent
# =============================================================================
# 'development' triggers the browser OAuth flow via `adk web`.
# Any other value activates production mode (header_provider, no auth_scheme).
ENVIRONMENT=development

# Gemini Enterprise authorization ID registered by Terraform.
# Must match the value in deployment/terraform/gemini_enterprise.tf
# Default: staging-weather-oauth-token
AUTH_ID=staging-weather-oauth-token

# Full URL of the locally-running MCP server (must include /mcp path)
MCP_URL=http://localhost:8080/mcp

# Agent configurations
GEMINI_MODEL=gemini-2.5-flash
RETRY_ATTEMPTS=3
MCP_TIMEOUT=60

# =============================================================================
# MCP Server
# =============================================================================
# OAuth scopes requested during Google login
OAUTH_SCOPES=openid email profile

# Redirect URI handled by the MCP server's OAuth callback endpoint
OAUTH_REDIRECT_URI_LOCAL=http://localhost:8080/oauth/callback

# Set to true when pointing the MCP server at the production OAuth redirect
USE_PRODUCTION_REDIRECT=false

# =============================================================================
# Model Backend (optional)
# =============================================================================
# 1 = Vertex AI (default), 0 = AI Studio (requires GOOGLE_API_KEY)
GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_API_KEY=your-ai-studio-key

# =============================================================================
# GitHub (local tooling only — never commit a real value here)
# =============================================================================
# GITHUB_PERSONAL_ACCESS_TOKEN=your-pat
