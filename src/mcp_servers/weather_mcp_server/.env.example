# GCP Project Settings
# Replace these with your actual GCP project details
SERVICE_NAME='weather-mcp-server-oauth'
LOCATION='us-central1'
PROJECT_ID='your-project-id'
PROJECT_NUMBER='your-project-number'

# OAuth2 Configuration
# Get these from Google Cloud Console > APIs & Credentials > OAuth 2.0 Client IDs
# These are REQUIRED - replace with your actual credentials
GOOGLE_CLIENT_ID='your-client-id.apps.googleusercontent.com'
GOOGLE_CLIENT_SECRET='your-client-secret'

# OAuth Scopes - What information to request from user during Google login
# 'openid' = Authenticate user's identity
# 'email' = Get user's email address
# 'profile' = Get user's name and profile picture
# DON'T CHANGE unless you need additional permissions from Google
OAUTH_SCOPES='openid email profile'

# MCP-specific configuration
# This is the scope required by the MCP protocol - DON'T CHANGE
MCP_SCOPE='user'

# MCP Server URL - Will be auto-set based on where server is running
# Local: http://localhost:8080/mcp
# Cloud Run: https://your-service-url.run.app/mcp/
MCP_SERVER_URL='http://localhost:8080/mcp'

# OAuth Redirect URIs
# Local development
OAUTH_REDIRECT_URI_LOCAL='http://localhost:8080/oauth/callback'
# Production (Vertex AI Search)
OAUTH_REDIRECT_URI_PROD='https://vertexaisearch.cloud.google.com/oauth-redirect'

# Which redirect URI to use
# Set to 'true' for production, 'false' for local development
USE_PRODUCTION_REDIRECT='false'
