# =============================================================================
# Production Environment Configuration
# =============================================================================
# Copy this to .env when deploying to production

# =============================================================================
# Model Backend Configuration
# =============================================================================
# Choose Model Backend: 0 -> ML Dev, 1 -> Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=1

# ML Dev backend config (only used if GOOGLE_GENAI_USE_VERTEXAI=0)
GOOGLE_API_KEY=YOUR_API_KEY

# =============================================================================
# Vertex AI Configuration
# =============================================================================
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
GOOGLE_CLOUD_LOCATION=YOUR_LOCATION
PROJECT_ID=YOUR_PROJECT_ID
PROJECT_NUMBER=YOUR_PROJECT_NUMBER

# =============================================================================
# MCP Server Configuration
# =============================================================================
MCP_URL=YOUR_MCP_SERVER_URL

# =============================================================================
# OAuth Configuration
# =============================================================================
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET

# OAuth Redirect URIs
# Development (local): ADK uses 127.0.0.1 with /dev-ui/ path
# Production (deployed): Use Vertex AI Search redirect
OAUTH_REDIRECT_URI_DEV=http://127.0.0.1:8000/dev-ui/
OAUTH_REDIRECT_URI_PROD=https://vertexaisearch.cloud.google.com/oauth-redirect

# =============================================================================
# Environment Configuration
# =============================================================================
# Set to 'production' when deployed, 'development' for local
ENVIRONMENT=production
AUTH_ID=YOUR_AUTH_ID

# =============================================================================
# Gemini Enterprise Configuration
# =============================================================================
# The location of your Gemini Enterprise engine (e.g., "global", "us-central1")
LOCATION=global

# The GCS bucket to use for storing logs and other data
GCS_BUCKET=YOUR_GCS_BUCKET

# The full resource name of your Gemini Enterprise engine
AS_APP=YOUR_AS_APP_ID

# The display name for your agent in Gemini Enterprise
DISPLAY_NAME=Your Agent Display Name

# A brief description (subtitle) of your agent
DESCRIPTION=Your Agent Description

# The tool description that defines the agent's capabilities and behavior
TOOL_DESCRIPTION=Your tool description and instructions

# The unique identifier for your agent
AGENT_ID=YOUR_AGENT_ID
