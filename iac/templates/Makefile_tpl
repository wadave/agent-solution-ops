-include ${env_script}

# Define Variables
ifndef project
	ifneq ($(strip $(GCP_PROJECT)),)
        override project = $(GCP_PROJECT)
    endif
endif

ifndef region
	ifneq ($(strip $(GCP_REGION)),)
        override region = $(GCP_REGION)
    endif
endif


VENV = venv
BUILD = build
PYTHON = $(VENV)/bin/python
PIP = $(VENV)/bin/pip
RUFF = $(VENV)/bin/ruff

# Make-timestamp Files
VENV_TIMESTAMP = $(BUILD)/.make.venv.done
INSTALL_TIMESTAMP = $(BUILD)/.make.install.done
INSTALL_PRECOMMIT_TIMESTAMP = $(BUILD)/.make.precommit.install.done



# Default target
.PHONY: all
all: help


# Check the Active GCloud Login
.PHONY: gcloud-check
gcloud-check:
	@echo -n "Active GCP Login: "
	@gcloud config list account --format "value(core.account)"
	@echo -n "Active GCP Project: "
	@gcloud config get-value project 2>&1 | grep -v 'Your active configuration is: '
	@echo -n "Active Service Account: "
	@curl "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/email" -H "Metadata-Flavor: Google" && echo ""


# Check the Active GCloud Login
.PHONY: login
login:
ifndef project
	$(error project is not set!  run: make login project=<your-gcp-project>)
endif
	@echo "GCloud Login"
	gcloud auth login --quiet --update-adc
	@echo "Setting GCloud Config Project"
	gcloud config set project "$(project)"
	@echo "Setting GCloud Application Default Quota Project"
	gcloud auth application-default set-quota-project "$(project)"


# Add APACHE-2.0 License
.PHONY: add-license
add-license:
	~/go/bin/addlicense -ignore **/docs/** -c "Google LLC" -l apache .


# Convert for External Sharing
.PHONY: external
external: add-license
	@bash -c ./iac/scripts/_tf_convert_external.sh


# Configure GCloud Project
.PHONY: set-project
set-project:
ifndef project
	$(error project is not set!  run: make set-project project=<your-gcp-project>)
endif
	@echo "Setting GCloud Config Project"
	gcloud config set project "$(project)"
	@echo "Setting GCloud Application Default Quota Project"
	gcloud auth application-default set-quota-project "$(project)"


# Fetch the Metadata Service Account
.PHONY: get-sa
get-sa:
	@curl "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/email" -H "Metadata-Flavor: Google" && echo ""


# Generate the TOC for the repo README.md
.PHONY: readme-toc
readme-toc:
	md_toc github --header-levels 4 README.md


# Update Remote Git Branches
.PHONY: update-branch
update-branch:
	git remote update origin --prune


# Create virtual environment
$(VENV_TIMESTAMP):
	@echo "🐍 Creating Python virtual environment in $(VENV)..."
	python3 -m venv $(VENV)
	mkdir -p $(BUILD)
	$(PIP) install --upgrade pip
	touch $(VENV_TIMESTAMP)

.PHONY: venv
venv: $(VENV_TIMESTAMP)


# Install dependencies
$(INSTALL_TIMESTAMP): $(VENV_TIMESTAMP) pyproject.toml
	@echo "🐍 Upgrading Python Dependencies in $(VENV)..."
	$(PIP) install -e .
	touch $(INSTALL_TIMESTAMP)

.PHONY: install
install: $(INSTALL_TIMESTAMP)


# Run tests in all services
.PHONY: tests
tests:
	@for service in services/*; do \
		if [ -d "$$service" ] && [ -f "$$service/Makefile" ]; then \
			echo "Testing $$service..."; \
			$(MAKE) -C $$service tests; \
		fi \
	done


# Run lint in all services
.PHONY: lint
lint: install
	@echo "Linting root..."
	$(RUFF) check . --extend-exclude services
	@for service in services/*; do \
		if [ -d "$$service" ] && [ -f "$$service/Makefile" ]; then \
			echo "Linting $$service..."; \
			$(MAKE) -C $$service lint; \
		fi \
	done


# Clean the Environment
.PHONY: clean
clean:
	@echo "🗑️  Executing Clean for repository"
	rm -rf $(VENV) $(BUILD)
	find . -type d -name "build" -exec rm -rf {} +
	find . -type d -name ".terraform" -exec rm -rf {} +
	find . -name ".terraform.*" -exec rm -f {} +
	find . -name "terraform.tfstate*" -exec rm -f {} +
	find . -type d -name "__pycache__" -exec rm -rf {} +
	find . -type d -name ".pytest_cache" -exec rm -rf {} +
	find . -type d -name ".ruff_cache" -exec rm -rf {} +
	find . -type d -name "*.egg-info" -exec rm -rf {} +
	find . -name ".coverage" -exec rm -f {} +


# Install precommit dependencies
$(INSTALL_PRECOMMIT_TIMESTAMP): $(INSTALL_TIMESTAMP) .pre-commit-config.yaml
	$(VENV)/bin/pre-commit install
	$(VENV)/bin/pre-commit install --hook-type pre-push
	touch $(INSTALL_PRECOMMIT_TIMESTAMP)

.PHONY: install-precommit
install-precommit: $(INSTALL_PRECOMMIT_TIMESTAMP)


# Run Pre-commit
.PHONY: precommit
precommit: install-precommit
	$(VENV)/bin/pre-commit run --all-files


# Help
.PHONY: help
help:
	@echo "Usage:"
	@echo "  make login             - Login to GCloud local SDK, application defaults, and set config and quota project"
	@echo "  make gcloud-check      - Check the gcloud active login and project"
	@echo "  make set-project       - Change the gcloud config and quota project"
	@echo "  make update-branch     - Refreshes remote Git branches into workspace"
	@echo "  make get-sa            - Fetch the service account associated with the environment"
	@echo "  make add-license       - Applies the Apache-2.0 license to all applicable files"
	@echo "  make external          - Convert for external sharing (output in ./exports)"
	@echo "  make readme-toc        - Output a generated TOC from the repository README.md"
	@echo "  make clean             - Clean environment"
	@echo "  make help              - Show help"
	@echo "  make venv              - Create virtual environment"
	@echo "  make install           - Install runtime dependencies"
